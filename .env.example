# AIHOT public API source.
AIHOT_BASE_URL=https://aihot.virxact.com

# Local web server.
PORT=8787

# Feishu custom bot webhook.
# Example: https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
FEISHU_WEBHOOK_URL=

# Optional Feishu custom bot signature secret.
FEISHU_BOT_SECRET=

# Defaults used by the local dashboard and daily push script.
AI_SOURCE_DEFAULT_MODE=selected
AI_SOURCE_DEFAULT_HOURS=24
AI_SOURCE_DEFAULT_TAKE=12
